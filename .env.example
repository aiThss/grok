# Public address. Set this before the very first production start.
WEBUI_URL=https://chat.example.com
CORS_ALLOW_ORIGIN=https://chat.example.com
WEBUI_SESSION_COOKIE_SECURE=true

# Generate once with: openssl rand -hex 32
# Keep this value in Dokploy Secrets; changing it invalidates sessions and
# encrypted stored credentials.
WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# Bootstrap account. These values are only used when the data volume is empty.
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=replace-with-a-long-unique-password
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending

# Keep the OpenAI-compatible provider restricted to only the intended models.
# The gateway URL must include its API version path, commonly /v1.
OPENAI_API_BASE_URL=https://gateway.example.com/v1
OPENAI_API_KEY=replace-with-a-least-privilege-provider-key
OPENAI_API_CONFIGS={"0":{"enable":true,"prefix_id":"ai","model_ids":["your-model-id"]}}
ENABLE_OPENAI_API_PASSTHROUGH=false

# Secure persisted plugin/function credentials and retain settings in the data volume.
ENABLE_VALVE_ENCRYPTION=true
ENABLE_PERSISTENT_CONFIG=true

# Used by docker-compose.yml for direct, local reverse-proxy deployment only.
OPEN_WEBUI_BIND_ADDRESS=127.0.0.1
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_VERSION=v0.11.0
