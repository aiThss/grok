# Required in Dokploy. This accepts an OpenAI-compatible Grok2API gateway too.
# Never use NEXT_PUBLIC_ for secrets.
GROK_BASE_URL=https://grok.babyress.games/v1
GROK_API_KEY=replace-with-a-new-api-key
# The only model the app exposes and permits.
GROK_DEFAULT_MODEL=grok-4.5

# Protects the personal app. Generate a long random password and secret.
APP_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: enables the direct-to-main GitHub workspace.
# Use a fine-grained token limited to the listed repos with Contents: Read and write.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_ALLOWED_REPOS=owner/repo-one,owner/repo-two
GITHUB_BRANCH=main
