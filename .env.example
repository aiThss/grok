# Địa chỉ công khai. Phải đặt trước lần khởi động production đầu tiên.
WEBUI_URL=https://chat.example.com
CORS_ALLOW_ORIGIN=https://chat.example.com
WEBUI_SESSION_COOKIE_SECURE=true

# Tạo một lần bằng: openssl rand -hex 32
# Lưu giá trị này trong Dokploy Secrets; thay đổi nó sẽ làm mất hiệu lực phiên
# đăng nhập và thông tin xác thực đã mã hóa.
WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# Tài khoản khởi tạo. Các giá trị này chỉ được dùng khi volume dữ liệu còn trống.
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=replace-with-a-long-unique-password
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending

# Chỉ cho phép các model cần dùng từ nhà cung cấp tương thích OpenAI.
# URL gateway phải có đường dẫn phiên bản API, thông thường là /v1.
OPENAI_API_BASE_URL=https://gateway.example.com/v1
OPENAI_API_KEY=replace-with-a-least-privilege-provider-key
OPENAI_API_CONFIGS={"0":{"enable":true,"prefix_id":"ai","model_ids":["your-model-id"]}}
ENABLE_OPENAI_API_PASSTHROUGH=false

# Mã hóa thông tin xác thực plugin/function lưu trong cơ sở dữ liệu và giữ lại
# cấu hình ở volume dữ liệu.
ENABLE_VALVE_ENCRYPTION=true
ENABLE_PERSISTENT_CONFIG=true

# Dùng bởi docker-compose.yml cho triển khai local qua reverse proxy.
OPEN_WEBUI_BIND_ADDRESS=127.0.0.1
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_VERSION=v0.11.0
