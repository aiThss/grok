# Bắt buộc trong Dokploy. URL có thể là host hoặc endpoint tương thích OpenAI;
# ứng dụng sẽ chuẩn hóa về đường dẫn /v1.
GROK_BASE_URL=https://gateway.example.com/v1
GROK_API_KEY=replace-with-a-new-api-key
GROK_DEFAULT_MODEL=grok-4.5
GROK_IMAGE_MODEL=grok-imagine-image-2.0

# Bảo vệ web chat. Tạo mật khẩu riêng và SESSION_SECRET dài ít nhất 32 ký tự.
APP_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Tùy chọn: kết nối GitHub trực tiếp. Token fine-grained chỉ cần quyền
# Contents: Read and write trên đúng các repository được cho phép.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_ALLOWED_REPOS=owner/repo-one,owner/repo-two
GITHUB_BRANCH=main
